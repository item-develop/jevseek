{
  "name": "jevseek",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "jevSeek — 動画に Ctrl+F を。YouTube の字幕を Jev で一括判定し、「〜の話」をした秒数へ飛ぶ拡張機能（starter）",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:ext": "tsx scripts/build-extension.ts",
    "seek": "tsx src/cli/seek.ts",
    "eval": "tsx src/cli/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "ai": "^7.0.107",
    "dotenv": "^18.0.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
