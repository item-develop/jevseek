{
  "name": "jevseek",
  "version": "0.0.1",
  "private": true,
  "description": "jevSeek — Ctrl+F for videos. A Chrome extension that finds the moment a YouTube video talks about something, using Jev (TypeSafe AI) to judge every caption segment in one request.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build:ext": "tsx scripts/build-extension.ts",
    "seek": "tsx src/cli/seek.ts",
    "eval": "tsx src/cli/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "ai": "^7.0.107",
    "dotenv": "^18.0.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
