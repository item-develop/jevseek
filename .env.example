# Vercel AI Gateway のキー（https://vercel.com/ai-gateway → API keys）。サーバーと CLI だけが読む。拡張機能には渡さない
AI_GATEWAY_API_KEY=
# 使うモデル。AI Gateway の ID
JEV_MODEL=typesafe-ai/jev
# セグメントごとの質問の型: boolean（既定, P(true) がそのまま熱量）| score（3 段階, 触れている/主題）
SEEK_QUESTION_TYPE=boolean
# 1 リクエストに入れる最大セグメント数（トークン上限対策。超えたら並列に分割）
SEEK_MAX_SEGMENTS_PER_REQUEST=120
# セグメント窓の長さ（秒）と最大文字数
SEEK_WINDOW_SEC=25
SEEK_WINDOW_CHARS=140
# 記録: 1 = すべての Jev リクエスト/レスポンスを recordings/*.jsonl に残す
SEEK_RECORD=0
PORT=8787
